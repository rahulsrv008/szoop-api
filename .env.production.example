APP_ENV=production
PORT=3002
DEMO_PAYMENT_MODE=false

# Neon Postgres (production only)
DB_USER=neondb_owner
DB_HOST=ep-divine-sea-b84rchve-pooler.c-14.us-east-1.aws.neon.tech
DB_NAME=neondb
DB_PASSWORD=
DB_PORT=5432
DB_TYPE=postgres
DB_SCHEMA=public
DB_POOL_MAX=5
DB_POOL_MAX_SERVERLESS=2
DB_POOL_IDLE_MS=10000
DB_POOL_CONN_TIMEOUT_MS=10000
DB_SSL=true
DB_SYNC=false
DB_LOGGING=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4300,http://localhost:4301,http://localhost:4302,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8091,http://localhost:8092,http://localhost:8093,https://admin-panel-two-delta.vercel.app,https://szoop.in,https://www.szoop.in,https://app.szoop.in,https://szoop-customer-app.vercel.app

# Logging
LOG_DIR=logs
ERROR_LOG_PATH=logs/error.log
WARN_LOG_PATH=logs/warn.log
INFO_LOG_PATH=logs/info.log
HTTP_LOG_PATH=logs/http.log
LOG_LEVEL=info
MORGAN_FORMAT=combined

# HTTP routes
API_PREFIX=api/v1
SWAGGER_ROUTE=api
HEALTH_CONTROLLER=health

# JWT access tokens (refresh tokens are opaque + hashed in refresh_tokens)
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000

# Admin Web bootstrap (npm run seed:admin -- email password)
ADMIN_EMAIL=admin@clearit.in
ADMIN_PASSWORD="    "

# SMS OTP — set SMS_PROVIDER=fast2sms|msg91|twilio and SMS_API_KEY, then OTP_DEMO_MODE=false
# blank provider or OTP_DEMO_MODE=true = OTP is 1111 and only logged, not texted
# SMS_PROVIDER=apitxt, fast2sms, msg91, or twilio
SMS_PROVIDER=apitxt
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_OTP_TEMPLATE=
SMS_CHANNEL=sms
SMS_COUNTRY=91
SMS_OTP_TEMPLATE_NAME=
SMS_PROJECT_REF_ID=
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Leave blank to use demo mode only when no provider is configured.
OTP_DEMO_MODE=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_Trf0VdFnIU7oSu
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=https://clearit-be.vercel.app/api/v1/razorpay/webhook

# Scheduled one-off jobs are broadcast this many minutes before their start time.
SCHEDULED_DISPATCH_LEAD_MINUTES=45
DISPATCH_TICK_MS=300000

# Maps / GPS
MAPS_API_KEY=
GPS_PING_INTERVAL_SECONDS=15

# Push (FCM) — blank = log-only stub
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# App URLs
APP_URL=https://clearit-be.vercel.app
STG_API_URL=

# Optional env fallbacks for system_settings (DB values win when present)
BOOKING_TAX_PERCENT=0
AGENT_PAYOUT_PERCENT=60
AGENT_FIXED_SALARY=0
AGENT_INCENTIVE_THRESHOLD=15000
AGENT_INCENTIVE_PERCENT=10
BOOKING_CANCELLATION_WINDOW_MINUTES=60
COOK_MORNING_PER_PERSON=1200
COOK_EVENING_PER_PERSON=1200
COOK_BOTH_PER_PERSON=2000
COOK_EXTRA_PERSON_DISCOUNT_PERCENT=10
COOK_CLEANING_MONTHLY=1200

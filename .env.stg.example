NODE_ENV=staging
PORT=3000

# Aiven / STG Postgres
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=27901
DB_TYPE=postgres
DB_SCHEMA=public
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_CONN_TIMEOUT_MS=10000
DB_SSL=true
DB_SYNC=false
DB_LOGGING=false

# Public API URL + admin / marketing / Expo web origins
APP_URL=https://stg-api.clearit.in
STG_API_URL=https://stg-api.clearit.in
ALLOWED_ORIGINS=https://stg-admin.clearit.in,https://stg.oseedy.com

LOG_DIR=logs
LOG_LEVEL=info
MORGAN_FORMAT=combined

API_PREFIX=api/v1
SWAGGER_ROUTE=api
HEALTH_CONTROLLER=health
ENABLE_SWAGGER=true
TRUST_PROXY=true

# Long random string — do not reuse the local default
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000

ADMIN_EMAIL=admin@clearit.in
ADMIN_PASSWORD=

# true keeps OTP in logs for QA; set false when MSG91 (or other) is live
OTP_DEMO_MODE=true
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=30
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_OTP_TEMPLATE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAPS_API_KEY=
GPS_PING_INTERVAL_SECONDS=15
FCM_SERVER_KEY=
FCM_PROJECT_ID=

BOOKING_TAX_PERCENT=0
AGENT_PAYOUT_PERCENT=60
AGENT_FIXED_SALARY=0
AGENT_INCENTIVE_THRESHOLD=15000
AGENT_INCENTIVE_PERCENT=10
BOOKING_CANCELLATION_WINDOW_MINUTES=60
COOK_MORNING_PER_PERSON=1200
COOK_EVENING_PER_PERSON=1200
COOK_BOTH_PER_PERSON=2000
COOK_EXTRA_PERSON_DISCOUNT_PERCENT=10
COOK_CLEANING_MONTHLY=1200

# Push dispatch (job offers to agents in waves)
# In-process tick interval in ms; 0 disables. Defaults to 15000, or off on Vercel.
DISPATCH_TICK_MS=15000
# Enables GET /api/v1/internal/dispatch/tick for an external cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

{
  "name": "clearit-be",
  "version": "0.1.0",
  "description": "CleanIt API — bookings, OTP auth, payments, and tracking",
  "author": "CleanIt",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:stg": "NODE_ENV=staging node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "seed:admin": "ts-node -r tsconfig-paths/register src/database/seeds/create-admin.ts",
    "backfill:h3": "ts-node -r tsconfig-paths/register src/database/seeds/backfill-h3.ts",
    "test:e2e": "TZ=UTC NODE_ENV=test TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register --test --test-concurrency=1 'test/e2e/*.e2e.ts'",
    "postman:generate": "node scripts/generate-postman-collection.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.21",
    "@nestjs/platform-express": "^11.0.21",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.1",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.0",
    "dotenv": "^17.4.0",
    "express": "^5.1.0",
    "h3-js": "^4.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.24",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.23",
    "@types/pg": "^8.15.2",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}

PORT=3000

# Database
DB_USER=clearit
DB_HOST=localhost
DB_NAME=clearit
DB_PASSWORD=
DB_PORT=5432
DB_TYPE=postgres
DB_SCHEMA=public
DB_POOL_MAX=5
# Per instance on Vercel (instances multiply it; keep under the DB's connection limit)
DB_POOL_MAX_SERVERLESS=2
DB_POOL_IDLE_MS=10000
DB_POOL_CONN_TIMEOUT_MS=10000
# Use false for local Postgres without SSL
DB_SSL=false
# Prefer migrations (sql/) over sync in shared environments
DB_SYNC=false
DB_LOGGING=false

# CORS — admin panel plus Expo. Mobile apps send no Origin and are always allowed.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8083,https://szoop.in,https://www.szoop.in,https://app.szoop.in

# Logging
LOG_DIR=logs
ERROR_LOG_PATH=logs/error.log
WARN_LOG_PATH=logs/warn.log
INFO_LOG_PATH=logs/info.log
HTTP_LOG_PATH=logs/http.log
LOG_LEVEL=info
MORGAN_FORMAT=combined

# HTTP routes (global prefix + swagger)
API_PREFIX=api/v1
SWAGGER_ROUTE=api
HEALTH_CONTROLLER=health

# JWT access tokens (refresh tokens are opaque + hashed in refresh_tokens)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000

# Admin Web bootstrap (npm run seed:admin -- email password)
ADMIN_EMAIL=admin@clearit.in
ADMIN_PASSWORD="ChangeMe#1234"

# SMS OTP (leave SMS_PROVIDER blank for demo mode; credentials are server-side only)
# SMS_PROVIDER=apitxt, fast2sms, msg91, or twilio
SMS_PROVIDER=apitxt
SMS_API_KEY=6gR1pyrOhmPUtkLhDEjqax1eEEGPIjxoPRen1Ccnz78
SMS_API_SECRET=
SMS_SENDER_ID=
# APITXT: channel is optional (sms by default); supports sms, whatsapp, or voice.
SMS_OTP_TEMPLATE_ID=
SMS_OTP_TEMPLATE=
SMS_CHANNEL=sms
# APITXT country defaults to 91 when omitted.
SMS_COUNTRY=91
# APITXT WhatsApp-only template settings; optional to use the system default.
SMS_OTP_TEMPLATE_NAME=
SMS_PROJECT_REF_ID=
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Leave blank to use demo mode only when no provider is configured.
OTP_DEMO_MODE=false

# Razorpay
# Local-only payment simulation; ignored in staging/production.
DEMO_PAYMENT_MODE=false
# Required in staging/production; use Razorpay test credentials in staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps / GPS
# Google Maps Platform key with the Routes API enabled; blank = distance-based ETA estimate.
MAPS_API_KEY=
# Routes API travel mode for agent ETAs: TWO_WHEELER | DRIVE
MAPS_TRAVEL_MODE=TWO_WHEELER
GPS_PING_INTERVAL_SECONDS=15

# Push (FCM) — blank = log-only stub
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# App URLs
APP_URL=http://localhost:3000
STG_API_URL=

# Optional env fallbacks for system_settings (DB values win when present)
BOOKING_TAX_PERCENT=0
AGENT_PAYOUT_PERCENT=60
AGENT_FIXED_SALARY=0
AGENT_INCENTIVE_THRESHOLD=15000
AGENT_INCENTIVE_PERCENT=10
BOOKING_CANCELLATION_WINDOW_MINUTES=60
COOK_MORNING_PER_PERSON=1200
COOK_EVENING_PER_PERSON=1200
COOK_BOTH_PER_PERSON=2000
COOK_EXTRA_PERSON_DISCOUNT_PERCENT=10
COOK_CLEANING_MONTHLY=1200

# Push dispatch (job offers to agents in waves)
# In-process tick interval in ms; 0 disables. Defaults to 15000, or off on Vercel.
DISPATCH_TICK_MS=15000
# Scheduled one-off jobs are broadcast this many minutes before their start time.
SCHEDULED_DISPATCH_LEAD_MINUTES=45
# Enables GET /api/v1/internal/dispatch/tick for an external cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# With no in-process timer (Vercel), app requests drive dispatch instead: at most one request
# per this many seconds, across all instances, runs a tick. Defaults to 20; 0 disables.
DISPATCH_REQUEST_TICK_SECONDS=20

# Pay after service: the agent app shows a QR for <base><bookingId>; scanned, it opens
# the customer app's pay screen for that booking. Default: the customer app's scheme.
CUSTOMER_PAY_URL_BASE=clearit://pay/

# Rate limiting (docs/rate-limiting.md)
# Shared counters across server instances. Unset = per-instance memory (fine locally).
# Upstash: rediss://default:<password>@<host>:6379 · AWS ElastiCache · Azure Cache for Redis (rediss://...:6380)
REDIS_URL=
# true for clustered Redis (ElastiCache cluster mode, Azure clustered / OSS cluster policy)
REDIS_CLUSTER=false
# Same-region Redis answers in ~1 ms. Slower calls trip the circuit breaker (Redis skipped, memory used).
RATE_LIMIT_REDIS_TIMEOUT_MS=100
RATE_LIMIT_REDIS_BREAKER_MS=30000
# Proxy hops in front of the app, so rate limits see the real client IP.
# Vercel: 1 · AWS ALB: 1 · CloudFront + ALB: 2 · or a subnet list like "loopback, 10.0.0.0/8"
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_TTL_MS=60000
# Per phone number (counted in Postgres)
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10
OTP_MAX_FAILED_PER_HOUR=10

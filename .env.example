PORT=3000

# Database
DB_USER=clearit
DB_HOST=localhost
DB_NAME=clearit
DB_PASSWORD=
DB_PORT=5432
DB_TYPE=postgres
DB_SCHEMA=public
DB_POOL_MAX=25
DB_POOL_IDLE_MS=10000
DB_POOL_CONN_TIMEOUT_MS=10000
# Use false for local Postgres without SSL
DB_SSL=false
# Prefer migrations (sql/) over sync in shared environments
DB_SYNC=false
DB_LOGGING=false

# CORS — admin panel plus Expo. Mobile apps send no Origin and are always allowed.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8081

# Logging
LOG_DIR=logs
ERROR_LOG_PATH=logs/error.log
WARN_LOG_PATH=logs/warn.log
INFO_LOG_PATH=logs/info.log
HTTP_LOG_PATH=logs/http.log
LOG_LEVEL=info
MORGAN_FORMAT=combined

# HTTP routes (global prefix + swagger)
API_PREFIX=api/v1
SWAGGER_ROUTE=api
HEALTH_CONTROLLER=health

# JWT access tokens (refresh tokens are opaque + hashed in refresh_tokens)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000

# Admin Web bootstrap (npm run seed:admin -- email password)
ADMIN_EMAIL=admin@clearit.in
ADMIN_PASSWORD="ChangeMe#1234"

# SMS OTP (leave blank to log OTPs in demo mode)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_OTP_TEMPLATE=
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_DEMO_MODE=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps / GPS
MAPS_API_KEY=
GPS_PING_INTERVAL_SECONDS=15

# Push (FCM) — blank = log-only stub
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# App URLs
APP_URL=http://localhost:3000
STG_API_URL=

# Optional env fallbacks for system_settings (DB values win when present)
BOOKING_TAX_PERCENT=0
AGENT_PAYOUT_PERCENT=60
AGENT_FIXED_SALARY=0
AGENT_INCENTIVE_THRESHOLD=15000
AGENT_INCENTIVE_PERCENT=10
BOOKING_CANCELLATION_WINDOW_MINUTES=60
COOK_MORNING_PER_PERSON=1200
COOK_EVENING_PER_PERSON=1200
COOK_BOTH_PER_PERSON=2000
COOK_EXTRA_PERSON_DISCOUNT_PERCENT=10
COOK_CLEANING_MONTHLY=1200

# Push dispatch (job offers to agents in waves)
# In-process tick interval in ms; 0 disables. Defaults to 15000, or off on Vercel.
DISPATCH_TICK_MS=15000
# Enables GET /api/v1/internal/dispatch/tick for an external cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
